	local function decode()
		local rev = {}
		for i = 1, 64 do rev[sbyte(ALPHA, i)] = i - 1 end
		local data = (DATA:gsub("%s+", ""))
		DATA = nil
		local out, on = {}, 0
		local buf, bn = {}, 0
		local prev, idx, sum, sum2 = 0, 0, 0, 0
		for p = 1, #data, 4 do
			local a, b, c, d = sbyte(data, p, p + 3)
			local n = rev[a] * 262144 + rev[b] * 4096 + rev[c] * 64 + rev[d]
			local x1 = floor(n / 65536)
			local x2 = floor(n / 256) % 256
			local x3 = n % 256

			local y = (x1 - KEY[idx % KL + 1] - prev - (idx * 7) % 256) % 256
			prev = x1; idx = idx + 1; sum = sum + y; sum2 = sum2 + sum
			bn = bn + 1; buf[bn] = y

			y = (x2 - KEY[idx % KL + 1] - prev - (idx * 7) % 256) % 256
			prev = x2; idx = idx + 1; sum = sum + y; sum2 = sum2 + sum
			bn = bn + 1; buf[bn] = y

			y = (x3 - KEY[idx % KL + 1] - prev - (idx * 7) % 256) % 256
			prev = x3; idx = idx + 1; sum = sum + y; sum2 = sum2 + sum
			bn = bn + 1; buf[bn] = y

			if bn >= 1998 then
				on = on + 1; out[on] = schar(unpack(buf, 1, bn))
				bn = 0
			end
		end
		if bn > 0 then
			on = on + 1; out[on] = schar(unpack(buf, 1, bn))
		end
		if sum ~= SUM or sum2 ~= SUM2 then return nil end
		local s = concat(out)
		if #s < LEN then return nil end
		return s:sub(1, LEN)
	end

	local ok, s = pcall(decode)
	if not ok or not s then
		error("TT Chat AI: file bi hong hoac thieu du lieu, hay tai lai", 0)
	end
	local f, err = ls(s, "=TTChatAI")
	if not f then
		error("TT Chat AI: " .. tostring(err), 0)
	end
	return f(...)
end

return _run(...)
